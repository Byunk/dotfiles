// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "max_output_tokens": 64,
      "model": "openai/gpt-5.4-nano",
      "api_url": "https://openrouter.ai/api/v1",
    },
    "allow_data_collection": "no",
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "group_by": "none",
    "tree_view": true,
    "dock": "left",
  },
  "scrollbar": {
    "selected_symbol": true,
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent",
        "fast-mode": "on",
        "reasoning_effort": "high",
        "model": "gpt-5.6-sol",
      },
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "search": {
    "include_ignored": false,
  },
  "format_on_save": "on",
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all",
        },
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "vim": {
    "use_system_clipboard": "on_yank",
  },
  "zoomed_padding": true,
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_close_button": "hover",
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "project_panel": {
    "dock": "left",
    "button": true,
  },
  "disable_ai": false,
  "agent": {
    "sandbox_permissions": {
      "write_paths": [],
      "network_hosts": [
        "learn.microsoft.com",
        "grep.app",
        "support.microsoft.com",
        "martinfowler.com",
        "xunitpatterns.com",
        "doc.rust-lang.org",
        "testing.googleblog.com",
        "raw.githubusercontent.com",
        "techcommunity.microsoft.com",
        "www.google.com",
        "www.bing.com",
        "github.com",
        "embarkstudios.github.io",
        "docs.rs",
        "api.github.com",
        "discourse.iced.rs",
        "support.apple.com",
        "duckduckgo.com",
      ],
    },
    "show_merge_conflict_indicator": true,
    "dock": "right",
    "thinking_display": "always_collapsed",
    "play_sound_when_agent_done": "always",
    "enable_feedback": false,
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "move_path": {
          "default": "allow",
        },
        "create_directory": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.4-mini",
      "enable_thinking": false,
    },
    "default_model": {
      "effort": "high",
      "speed": "fast",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "button": true,
    "font_family": "Noto Sans",
    "blinking": "on",
  },
  "base_keymap": "Cursor",
  "minimap": {
    "show": "never",
  },
  "file_types": {
    "tailwindcss": ["*.css"],
  },
  "show_whitespaces": "all",
  "soft_wrap": "editor_width",
  "hard_tabs": false,
  "tab_size": 2,
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
